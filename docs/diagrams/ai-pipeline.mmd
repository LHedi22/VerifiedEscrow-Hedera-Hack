flowchart TB
    subgraph FUND["At funding · POST /contracts/{id}/fund"]
      direction TB
      F0([Escrow funded on-chain]) --> F1{Same sow_hash already<br/>has criteria?}
      F1 -->|yes| F2[Copy criteria<br/>timeline: criteria_reused]
      F1 -->|no| F3[Step 1 · Criteria extraction<br/>criteria_system.txt · num_predict 512]
      F3 --> F4[(evaluations.criteria<br/>3–7 presence-checkable criteria)]
      F2 --> F4
    end

    subgraph EVAL["On deliverable · POST /contracts/{id}/deliverable → EVALUATING"]
      direction TB
      E0([Normalized deliverable]) --> E1{DEMO_REPLAY=1 and a<br/>recording matches?}
      E1 -->|yes| E2[Replay recorded verdict<br/>model_version = replay/…<br/>no Ollama call]
      E1 -->|no| E3[Step 2 · Evaluation<br/>evaluation_system.txt · num_predict 1200<br/>deliverable wrapped in &lt;deliverable&gt; tags = DATA]
      E3 --> E4{Pydantic validation<br/>JSON · criterion IDs · 0 ≤ confidence ≤ 1<br/>done_reason ≠ length}
      E4 -->|invalid, attempt &lt; 3| E3
      E4 -->|invalid ×3| E5[EVALUATION_ERROR<br/>verdict = fail · hold_reason = EVALUATION_ERROR]
      E4 -->|valid| E6[Per-criterion results · reasoning<br/>confidence · injection_suspected]
      E6 --> E7[Injection regex backstop<br/>on the deliverable text]
      E7 --> E8{Code aggregation<br/>all required met AND<br/>confidence ≥ 0.7 AND<br/>no injection?}
      E8 -->|yes| E9[verdict = pass]
      E8 -->|no| E10[verdict = fail]
    end

    F4 -.->|criteria input| E3
    OL[[Ollama · qwen2.5:7b-instruct<br/>JSON schema · temp 0 · seed 42<br/>num_ctx 8192 · keep_alive -1<br/>Semaphore 1]]
    F3 <-.-> OL
    E3 <-.-> OL
    OL -->|unreachable / 90 s timeout| ERR[ERROR at EVALUATING<br/>nothing anchored · Retry]

    subgraph RECORD["Record → Hedera"]
      direction TB
      R1[Canonical record · 8 string keys<br/>reasoning ≤ 3,000 chars · sorted · UTF-8]
      R1 --> R2[SHA-256 = recordHash<br/>size ≤ 18 KB]
      R2 --> R3[ANCHORING · HCS submit<br/>full bytes, chunked, oracle-only topic]
      R3 --> R4[CONFIRMING · mirror node<br/>reassemble + hash match]
      R4 --> R5[Verdict revealed in the app]
      R4 --> R6[SUBMITTING_VERDICT<br/>submitVerdict · recordHash, passed, sowHash]
      R6 --> R7([RELEASED or HELD])
    end

    E2 --> R1
    E5 --> R1
    E9 --> R1
    E10 --> R1

    classDef model fill:#EEF3F8,stroke:#1F3A5F,color:#1F3A5F
    classDef bad fill:#FDECEC,stroke:#C0392B,color:#7A1F16
    classDef good fill:#E8F5EC,stroke:#1E7A45,color:#12472A
    class OL model
    class ERR,E5,E10 bad
    class E9,R7 good
